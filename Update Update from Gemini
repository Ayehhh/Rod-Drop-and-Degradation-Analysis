avg_wear_rate = (wear_um[-1] - wear_um[0]) / days[-1] if days[-1] > 0 else 0
eps = 0.01
inst_wear_rate = (best["func"](days[-1] + eps, *best["popt"]) - best["func"](days[-1] - eps, *best["popt"])) / (2 * eps)

