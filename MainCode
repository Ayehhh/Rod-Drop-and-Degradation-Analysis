#!/usr/bin/env python3
"""
================================================================================
 RECIPROCATING COMPRESSOR PISTON ROD CLEARANCE - PROGNOSTIC WEAR TRENDING TOOL
================================================================================
Reads BN3500 rod drop historical trend data from an Excel export, converts
probe-domain readings into clearance-domain values (mm), fits multiple
degradation regression models, auto-selects the best fit by R^2, and
forecasts the date range (at a user-defined confidence level) when the
trend will reach the L alarm, LL alarm, and Minimum Allowable Clearance.

Required packages: pandas, numpy, scipy, matplotlib, openpyxl
    pip install pandas numpy scipy matplotlib openpyxl

Usage:
    python clearance_prognostic_tool.py

--------------------------------------------------------------------------------
ENGINEERING CONVENTIONS USED IN THIS TOOL
--------------------------------------------------------------------------------
1. Clearance-domain conversion (matches BN3500 L/LL setpoint convention):
       Clearance_at_L_alarm  (mm) = New_Clearance (mm) - BN_L_threshold (um)/1000
       Clearance_at_LL_alarm (mm) = New_Clearance (mm) - BN_LL_threshold(um)/1000
       Estimated_current_clearance (mm) = New_Clearance (mm) - Wear (um)/1000

   NOTE: This is the C-2125-style convention (New Clearance - threshold).
   Burckhardt-style units use H/HH = New Clearance - Min Clearance - Piston
   Lift instead. If this run is for a Burckhardt-convention unit, adjust the
   MIN_CLEARANCE input accordingly or edit wear_target_min in main().

2. Sign convention (probe orientation):
   Positive wear (um) must always mean "moving toward failure / clearance
   loss", regardless of physical probe mounting. The tool suggests a default
   polarity per orientation below, but ALWAYS confirm against known physical
   behavior for the specific throw before trusting the output - polarity is
   site/installation specific.
       Vertical - Top mounted    : suggested sign = +1 (rod sags away from
                                    top probe under gravity = increasing gap)
       Vertical - Bottom mounted : suggested sign = -1 (rod sags toward
                                    bottom probe = decreasing gap)
       Horizontal - Left mounted : suggested sign = +1 (site-specific, verify)
       Horizontal - Right mounted: suggested sign = -1 (site-specific, verify)
================================================================================
"""

import os
import sys
from datetime import timedelta

import numpy as np
import pandas as pd
from scipy import stats
from scipy.optimize import brentq, curve_fit

import matplotlib
matplotlib.use("Agg")  # safe default; switch to interactive backend if desired
import matplotlib.pyplot as plt

OUTPUT_DIR = "output"


# ==============================================================================
# 1. INPUT HELPERS
# ==============================================================================

def get_float_input(prompt_text, allow_blank=False, default=None):
    while True:
        raw = input(prompt_text).strip()
        if raw == "" and allow_blank:
            return default
        try:
            return float(raw)
        except ValueError:
            print("  >> Invalid number, please try again.")


def get_int_input(prompt_text, default):
    raw = input(prompt_text).strip()
    if raw == "":
        return default
    try:
        return int(raw)
    except ValueError:
        print(f"  >> Invalid entry, using default ({default}).")
        return default


def get_yes_no(prompt_text, default_yes=True):
    suffix = " [Y/n]: " if default_yes else " [y/N]: "
    raw = input(prompt_text + suffix).strip().lower()
    if raw == "":
        return default_yes
    return raw.startswith("y")


# ==============================================================================
# 2. CLEARANCE / ALARM SETPOINT INPUT
# ==============================================================================

def collect_clearance_inputs():
    print("\n=== CLEARANCE & ALARM SETPOINT INPUT ===")
    new_clearance = get_float_input("New (as-new) clearance [mm]: ")
    bn_l = get_float_input("BN3500 L alarm threshold [um, probe/rack domain]: ")
    bn_ll = get_float_input("BN3500 LL alarm threshold [um, probe/rack domain]: ")
    min_clearance = get_float_input("Minimum allowable clearance [mm]: ")

    clearance_at_L = new_clearance - abs((bn_l / 1000.0))
    clearance_at_LL = new_clearance - abs((bn_ll / 1000.0))

    print(f"\n  --> Clearance at L  alarm = {new_clearance:.4f} - {bn_l:.1f}/1000 = {clearance_at_L:.4f} mm")
    print(f"  --> Clearance at LL alarm = {new_clearance:.4f} - {bn_ll:.1f}/1000 = {clearance_at_LL:.4f} mm")
    print(f"  --> Minimum allowable clearance                    = {min_clearance:.4f} mm")

    return new_clearance, bn_l, bn_ll, min_clearance, clearance_at_L, clearance_at_LL


# ==============================================================================
# 3. PROBE ORIENTATION / SIGN CONVENTION  // to remove
# ==============================================================================

ORIENTATION_OPTIONS = {
    "1": ("Vertical - Top mounted", +1),
    "2": ("Vertical - Bottom mounted", -1),
    "3": ("Horizontal - Left mounted", +1),
    "4": ("Horizontal - Right mounted", -1),
}


def collect_probe_orientation():
    print("\n=== PROBE ORIENTATION ===")
    for k, (label, sign) in ORIENTATION_OPTIONS.items():
        print(f"  {k}) {label}  (suggested polarity: {'+1' if sign > 0 else '-1'})")

    while True:
        choice = input("Select probe orientation [1-4]: ").strip()
        if choice in ORIENTATION_OPTIONS:
            break
        print("  >> Please enter 1, 2, 3, or 4.")

    label, suggested_sign = ORIENTATION_OPTIONS[choice]
    print(f"\nSelected: {label}")
    print("Convention check: a POSITIVE raw reading should mean the rod/piston")
    print("is moving in the WEAR direction (clearance being consumed).")
    confirm = get_yes_no(f"Accept suggested polarity ({'+1' if suggested_sign > 0 else '-1'}) for this throw?",
                          default_yes=True)
    sign = suggested_sign if confirm else -suggested_sign
    print(f"  --> Sign correction factor applied to raw readings: {sign:+d}")
    return label, sign


# ==============================================================================
# 4. HISTORICAL DATA (EXCEL) LOADING
# ==============================================================================

def load_historical_data():
    print("\n=== HISTORICAL DATA (Excel) ===")
    while True:
        filepath = input("Full path to historical data Excel file (.xlsx): ").strip().strip('"').strip("'")
        if os.path.isfile(filepath):
            break
        print("  >> File not found. Check the path and try again.")

    xls = pd.ExcelFile(filepath)
    if len(xls.sheet_names) > 1:
        print(f"Sheets found: {xls.sheet_names}")
        sheet = input(f"Which sheet to use? [default: {xls.sheet_names[0]}]: ").strip()
        sheet = sheet if sheet else xls.sheet_names[0]
    else:
        sheet = xls.sheet_names[0]

    df_raw = pd.read_excel(filepath, sheet_name=sheet)
    print(f"\nColumns found: {list(df_raw.columns)}")

    while True:
        ts_col = input("Column name for TIMESTAMP: ").strip()
        if ts_col in df_raw.columns:
            break
        print("  >> Column not found, check spelling/case and try again.")

    while True:
        val_col = input("Column name for ROD DROP / PROBE READING [um]: ").strip()
        if val_col in df_raw.columns:
            break
        print("  >> Column not found, check spelling/case and try again.")

    df = df_raw[[ts_col, val_col]].dropna().copy()
    df.columns = ["timestamp", "raw_reading_um"]
    df["timestamp"] = pd.to_datetime(df["timestamp"])
    df["raw_reading_um"] = pd.to_numeric(df["raw_reading_um"], errors="coerce")
    df = df.dropna().sort_values("timestamp").reset_index(drop=True)

    if len(df) < 3:
        print("  >> WARNING: fewer than 3 valid data points found. Regression will be unreliable.")

    print(f"  --> Loaded {len(df)} valid readings, "
          f"{df['timestamp'].iloc[0]} to {df['timestamp'].iloc[-1]}")
    return df


# ==============================================================================
# 5. SIGN CORRECTION + CLEARANCE-DOMAIN CONVERSION
# ==============================================================================

def apply_sign_and_clearance(df, sign, new_clearance_mm):
    df = df.copy()
    df["wear_um"] = df["raw_reading_um"] * sign           # positive = clearance loss
    df["clearance_mm"] = new_clearance_mm - (df["wear_um"] / 1000.0)
    return df


# ==============================================================================
# 6. CONFIDENCE LEVEL INPUT
# ==============================================================================

def get_confidence_level():
    print("\n=== PROGNOSTIC CONFIDENCE LEVEL ===")
    while True:
        val = get_float_input("Confidence level for degradation forecast, e.g. 95 for 95%: ")
        if 0 < val < 100:
            return val
        print("  >> Enter a value between 0 and 100.")


# ==============================================================================
# 7. REGRESSION MODEL FITTING
# ==============================================================================

def _lin(x, a, b):
    return a * x + b


def _quad(x, a, b, c):
    return a * x ** 2 + b * x + c


def _power(x, a, b):
    return a * np.power(x + 1e-6, b)


def _expo(x, a, b):
    return a * np.exp(b * x)


def _logf(x, a, b):
    return a * np.log(x + 1.0) + b


MODEL_CANDIDATES = {
    "Linear": (_lin, [1.0, 0.0]),
    "Quadratic": (_quad, [0.01, 1.0, 0.0]),
    "Power": (_power, [1.0, 1.0]),
    "Exponential": (_expo, [1.0, 0.01]),
    "Logarithmic": (_logf, [1.0, 0.0]),
}


def fit_models(x, y):
    results = {}
    for name, (func, p0) in MODEL_CANDIDATES.items():
        try:
            popt, pcov = curve_fit(func, x, y, p0=p0, maxfev=20000)
            y_pred = func(x, *popt)
            ss_res = np.sum((y - y_pred) ** 2)
            ss_tot = np.sum((y - np.mean(y)) ** 2)
            r2 = 1 - ss_res / ss_tot if ss_tot > 0 else float("nan")
            dof = max(len(x) - len(popt), 1)
            resid_std = np.sqrt(ss_res / dof)
            results[name] = {
                "func": func, "popt": popt, "r2": r2,
                "resid_std": resid_std, "dof": dof,
            }
        except (RuntimeError, ValueError):
            results[name] = {"error": "fit failed to converge"}
    return results


def select_best_model(model_results):
    valid = {k: v for k, v in model_results.items() if "r2" in v and not np.isnan(v["r2"])}
    if not valid:
        raise RuntimeError("No candidate model could be fit to this data set.")
    best_name = max(valid, key=lambda k: valid[k]["r2"])
    return best_name, valid


# ==============================================================================
# 8. FORECAST: TIME-TO-THRESHOLD WITH CONFIDENCE BAND
# ==============================================================================

def find_crossing_days(model_result, target_wear, confidence_pct, x_max_days):
    func = model_result["func"]
    popt = model_result["popt"]
    dof = model_result["dof"]
    resid_std = model_result["resid_std"]

    t_val = stats.t.ppf((1 + confidence_pct / 100.0) / 2, dof) if dof >= 1 else 0.0
    band = t_val * resid_std

    def f_central(x):
        return func(x, *popt) - target_wear

    def f_upper(x):   # optimistic wear (+band) -> crosses target SOONER
        return func(x, *popt) + band - target_wear

    def f_lower(x):   # conservative wear (-band) -> crosses target LATER
        return func(x, *popt) - band - target_wear

    def solve(f):
        xs = np.linspace(0, x_max_days, 20000)
        ys = f(xs)
        sign_changes = np.where(np.diff(np.sign(ys)) != 0)[0]
        if len(sign_changes) == 0:
            return None
        idx = sign_changes[0]
        try:
            return brentq(f, xs[idx], xs[idx + 1])
        except (ValueError, RuntimeError):
            return None

    return solve(f_upper), solve(f_central), solve(f_lower), band


def day_to_date(t0, day):
    return t0 + timedelta(days=day) if day is not None else None


def fmt_date(d):
    return d.strftime("%Y-%m-%d") if d is not None else "beyond forecast horizon"


# ==============================================================================
# 9. PLOTTING
# ==============================================================================

def plot_trend(df, model_name, model_result, t0, clearance_at_L, clearance_at_LL,
                min_clearance_mm, new_clearance_mm, confidence_pct, x_max_days, out_path,
                crossing_dates=None):
    fig, ax = plt.subplots(figsize=(12, 7))

    ax.scatter(df["timestamp"], df["clearance_mm"], s=18, color="#1f77b4",
               label="Historical clearance (measured)", zorder=3)

    x_future = np.linspace(0, x_max_days, 600)
    y_wear_future = model_result["func"](x_future, *model_result["popt"])
    y_clear_future = new_clearance_mm - y_wear_future / 1000.0
    dates_future = [t0 + timedelta(days=d) for d in x_future]

    ax.plot(dates_future, y_clear_future, color="#d62728", linewidth=2,
            label=f"Best-fit model: {model_name} (R\u00b2={model_result['r2']:.4f})", zorder=2)

    t_val = stats.t.ppf((1 + confidence_pct / 100.0) / 2, model_result["dof"]) if model_result["dof"] >= 1 else 0.0
    band_mm = (t_val * model_result["resid_std"]) / 1000.0
    ax.fill_between(dates_future, y_clear_future - band_mm, y_clear_future + band_mm,
                     color="#d62728", alpha=0.15, label=f"{confidence_pct:.0f}% confidence band", zorder=1)

    ax.axhline(clearance_at_L, color="#ff7f0e", linestyle="--", linewidth=1.5,
               label=f"L alarm ({clearance_at_L:.4f} mm)")
    ax.axhline(clearance_at_LL, color="#d62728", linestyle="--", linewidth=1.5,
               label=f"LL alarm ({clearance_at_LL:.4f} mm)")
    ax.axhline(min_clearance_mm, color="black", linestyle=":", linewidth=1.5,
               label=f"Min allowable clearance ({min_clearance_mm:.4f} mm)")

    if crossing_dates:
        marker_colors = {"L": "#ff7f0e", "LL": "#d62728", "Min": "black"}
        for label, d in crossing_dates.items():
            if d is not None:
                ax.axvline(d, color=marker_colors.get(label, "gray"), linestyle="-",
                           linewidth=0.8, alpha=0.6)
                ax.annotate(f"{label}\n{d.strftime('%Y-%m-%d')}", xy=(d, ax.get_ylim()[1]),
                            xytext=(3, -3), textcoords="offset points", fontsize=7,
                            va="top", color=marker_colors.get(label, "gray"))

    ax.set_xlabel("Date")
    ax.set_ylabel("Clearance (mm)")
    ax.set_title("Piston Rod Clearance - Wear Trend & Prognostic Forecast")
    ax.legend(loc="best", fontsize=8)
    ax.grid(alpha=0.3)
    fig.autofmt_xdate()
    fig.tight_layout()
    fig.savefig(out_path, dpi=150, bbox_inches="tight")
    plt.close(fig)


# ==============================================================================
# 10. MAIN
# ==============================================================================

def main():
    print("=" * 78)
    print(" RECIPROCATING COMPRESSOR PISTON ROD CLEARANCE")
    print(" PROGNOSTIC WEAR TRENDING TOOL")
    print("=" * 78)

    (new_clearance, bn_l, bn_ll, min_clearance,
     clearance_at_L, clearance_at_LL) = collect_clearance_inputs()

    orientation_label, sign = collect_probe_orientation()

    df = load_historical_data()
    df = apply_sign_and_clearance(df, sign, new_clearance)

    confidence_pct = get_confidence_level()

    n_total = len(df)
    default_n = min(5, n_total)
    n_recent = get_int_input(
        f"\nHow many most recent readings to average for 'current' probe position? [default {default_n}]: ",
        default_n)
    n_recent = max(1, min(n_recent, n_total))

    # --- time base ---
    t0 = df["timestamp"].iloc[0]
    days = (df["timestamp"] - t0).dt.total_seconds().values / 86400.0
    wear_um = df["wear_um"].values

    # --- regression ---
    print("\nFitting candidate degradation models...")
    model_results = fit_models(days, wear_um)
    best_name, valid_models = select_best_model(model_results)
    best = valid_models[best_name]

    print("\nModel comparison (R\u00b2):")
    for name, res in model_results.items():
        if "error" in res:
            print(f"  {name:15s} FAILED ({res['error']})")
        else:
            marker = "  <== SELECTED" if name == best_name else ""
            print(f"  {name:15s} R\u00b2 = {res['r2']:.4f}{marker}")

    if best["dof"] < 3:
        print("\n  >> CAUTION: very few degrees of freedom (dof={}). "
              "Confidence band and forecast dates are indicative only.".format(best["dof"]))
    if best["r2"] < 0.5:
        print(f"\n  >> CAUTION: best R\u00b2 ({best['r2']:.3f}) is low. Trend is not well captured "
              f"by any candidate model - treat forecast dates with caution.")

    # --- current position / clearance ---
    recent_df = df.tail(n_recent)
    avg_raw_current = recent_df["raw_reading_um"].mean()
    avg_wear_current = recent_df["wear_um"].mean()
    current_clearance = new_clearance - (avg_wear_current / 1000.0)

    # --- wear rate ---
    avg_wear_rate = ((wear_um[-1] - wear_um[0]) / (days[-1] - days[0])
                      if days[-1] > days[0] else float("nan"))
    eps = 0.05
    inst_wear_rate = (best["func"](days[-1] + eps, *best["popt"]) -
                       best["func"](days[-1] - eps, *best["popt"])) / (2 * eps)

    # --- forecast targets (wear-domain) ---
    wear_target_L = bn_l
    wear_target_LL = bn_ll
    wear_target_min = (new_clearance - min_clearance) * 1000.0

    x_max_days = max(days[-1] * 4, days[-1] + 3650)  # generous horizon for extrapolation search

    early_L, cen_L, late_L, band_L = find_crossing_days(best, wear_target_L, confidence_pct, x_max_days)
    early_LL, cen_LL, late_LL, band_LL = find_crossing_days(best, wear_target_LL, confidence_pct, x_max_days)
    early_min, cen_min, late_min, band_min = find_crossing_days(best, wear_target_min, confidence_pct, x_max_days)

    d_early_L, d_cen_L, d_late_L = (day_to_date(t0, x) for x in (early_L, cen_L, late_L))
    d_early_LL, d_cen_LL, d_late_LL = (day_to_date(t0, x) for x in (early_LL, cen_LL, late_LL))
    d_early_min, d_cen_min, d_late_min = (day_to_date(t0, x) for x in (early_min, cen_min, late_min))

    # --- plot range: zoom to a sensible window around the actual forecasts
    # instead of the full (generous) root-search horizon ---
    candidate_days = [d for d in (late_L, late_LL, late_min, cen_L, cen_LL, cen_min) if d is not None]
    if candidate_days:
        x_plot_max = max(max(candidate_days) * 1.15, days[-1] * 1.2)
    else:
        x_plot_max = max(days[-1] * 3, days[-1] + 365)  # fallback if no threshold ever reached

    os.makedirs(OUTPUT_DIR, exist_ok=True)
    plot_path = os.path.join(OUTPUT_DIR, "clearance_trend_prognostic.png")
    plot_trend(df, best_name, best, t0, clearance_at_L, clearance_at_LL, min_clearance,
               new_clearance, confidence_pct, x_plot_max, plot_path,
               crossing_dates={"L": d_cen_L, "LL": d_cen_LL, "Min": d_cen_min})

    # --- processed data export ---
    export_path = os.path.join(OUTPUT_DIR, "processed_clearance_trend.csv")
    df.to_csv(export_path, index=False)

    # ==========================================================================
    # SUMMARY OUTPUT
    # ==========================================================================
    print("\n" + "=" * 78)
    print("SUMMARY OUTPUT")
    print("=" * 78)
    print(f"Probe orientation                  : {orientation_label} (sign {sign:+d})")
    print(f"Current average probe position      : {avg_raw_current:.2f} um  "
          f"(mean of last {n_recent} reading(s))")
    print(f"Estimated current clearance         : {current_clearance:.4f} mm")
    print(f"Average wear rate (start-to-last)   : {avg_wear_rate:.4f} um/day")
    print(f"Model-based instantaneous wear rate : {inst_wear_rate:.4f} um/day")
    print(f"Best-fit prognostic model           : {best_name} (R\u00b2 = {best['r2']:.4f})")
    print(f"Confidence level applied            : {confidence_pct:.0f}%")

    print("\nPrognostic forecast (early <-- central --> late, at "
          f"{confidence_pct:.0f}% confidence):")
    print(f"  L alarm   ({clearance_at_L:.4f} mm | wear={wear_target_L:.1f} um):")
    print(f"      {fmt_date(d_early_L)}  <--  {fmt_date(d_cen_L)}  -->  {fmt_date(d_late_L)}")
    print(f"  LL alarm  ({clearance_at_LL:.4f} mm | wear={wear_target_LL:.1f} um):")
    print(f"      {fmt_date(d_early_LL)}  <--  {fmt_date(d_cen_LL)}  -->  {fmt_date(d_late_LL)}")
    print(f"  Min allowable clearance ({min_clearance:.4f} mm | wear={wear_target_min:.1f} um):")
    print(f"      {fmt_date(d_early_min)}  <--  {fmt_date(d_cen_min)}  -->  {fmt_date(d_late_min)}")

    print(f"\nPlot saved to        : {plot_path}")
    print(f"Processed data saved : {export_path}")
    print("=" * 78)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\nAborted by user.")
        sys.exit(1)
